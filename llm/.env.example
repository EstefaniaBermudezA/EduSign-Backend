# Plantilla de variables de entorno para el módulo LLM
# Copia este archivo a .env y rellena con tus valores reales
# IMPORTANTE: El archivo .env NUNCA debe subirse a GitHub (ya está en .gitignore)

# Token de Hugging Face (obtener en https://huggingface.co/settings/tokens)
HF_TOKEN=tu_token_de_huggingface_aqui

# Timeout en segundos para las peticiones al modelo
HF_TIMEOUT_S=60

# URL base de la API compatible con OpenAI (router actual de Hugging Face)
OPENAI_BASE_URL=https://router.huggingface.co/v1

# Identificador del modelo a utilizar (3B para baja latencia)
MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
